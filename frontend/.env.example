# Backend API URL (for server-side). The Next.js `/api/*` proxy uses this on localhost when set;
# otherwise it defaults to http://localhost:4000 (it does NOT use NEXT_PUBLIC_API_BASE_URL on
# localhost, so you can keep NEXT_PUBLIC pointing at production for deployed previews without
# breaking local proxying).
BACKEND_URL=http://localhost:4000

# Public API URL (for client-side direct calls when not using same-origin /api proxy)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# WebSocket URL
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional fallback if Admin → Settings → Telegram invite link is empty
# NEXT_PUBLIC_TELEGRAM_INVITE_URL=https://t.me/yourchannel

# Environment
NODE_ENV=development

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://thefxnavigators.com

# Search engine verification (optional — paste codes from Search Console / Bing Webmaster)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-code
# NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=your-yandex-verification-code

# Optional social profile URLs (included in Organization JSON-LD when set)
# NEXT_PUBLIC_SOCIAL_TWITTER_URL=https://x.com/thefxnavigators
# NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/yourhandle
# NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/yourpage
# NEXT_PUBLIC_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@yourchannel
# NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=https://www.facebook.com/yourpage

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-9YREN3L4TL
