PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Local MongoDB (recommended for dev)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=forex_navi_local

# JWT secret for local dev
JWT_SECRET=change-me-local-dev


# Optional: Cloudinary (leave blank in local dev if not uploading)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=



SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Email From Configuration
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Forex Navigators
