# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# Forex Navigators LMS Backend
# ==========================================
# 
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env.production
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env.production to version control
# 4. Keep this file secure and backed up
# ==========================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=4000

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB connection string for production
# Format: mongodb://username:password@host:port/database
# or for MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://localhost:27017/forex-lms-production
MONGODB_URI=mongodb://localhost:27017/forex-lms-production

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================
# JWT Secret Key - MUST be a strong, random string (min 64 characters recommended)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production-min-64-chars

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
# Production frontend URL (no trailing slash)
FRONTEND_URL=https://thefxnavigators.com

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================
# Cloudinary credentials for file uploads (images, videos, documents)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ==========================================
# STRIPE PAYMENT GATEWAY
# ==========================================
# Stripe API keys for international payments
# Get these from: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use LIVE keys for production (starts with pk_live_ and sk_live_)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ==========================================
# EASYPAISA PAYMENT GATEWAY (Pakistan)
# ==========================================
# EasyPaisa credentials for local payment processing
# Get these from EasyPaisa merchant portal
EASYPAISA_BASE_URL=https://easypay.easypaisa.com.pk
EASYPAISA_STORE_ID=your-easypaisa-store-id
EASYPAISA_STORE_PASSWORD=your-easypaisa-store-password
EASYPAISA_API_KEY=your-easypaisa-api-key
EASYPAISA_RETURN_URL=https://thefxnavigators.com/payment/easypaisa/callback
EASYPAISA_NOTIFY_URL=https://api.thefxnavigators.com/api/payments/easypaisa/webhook

# ==========================================
# JAZZCASH PAYMENT GATEWAY (Pakistan)
# ==========================================
# JazzCash credentials for local payment processing
# Get these from JazzCash merchant portal
JAZZCASH_BASE_URL=https://payments.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=your-jazzcash-merchant-id
JAZZCASH_PASSWORD=your-jazzcash-password
JAZZCASH_INTEGRATION_ID=your-jazzcash-integration-id
JAZZCASH_RETURN_URL=https://thefxnavigators.com/payment/jazzcash/callback
JAZZCASH_NOTIFY_URL=https://api.thefxnavigators.com/api/payments/jazzcash/webhook

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================
# NOTE: Email settings are primarily managed through the database Settings model
# These are fallback/default values if database settings are not configured
# Recommended SMTP providers: SendGrid, AWS SES, Mailgun, Gmail (for testing only)

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=thefxnavigators@gmail.com
SMTP_PASSWORD=fdld vant ffep kxzf

# Email From Configuration
SMTP_FROM_EMAIL=thefxnavigators@gmail.com
SMTP_FROM_NAME=Forex Navigators

# Email Mock Mode (set to false in production)
EMAIL_MOCK_MODE=false

# ==========================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ==========================================
# 2FA is handled by speakeasy library - no additional config needed
# Platform name shown in authenticator apps
TWO_FACTOR_PLATFORM_NAME=Forex Navigators

# ==========================================
# REFERRAL SYSTEM
# ==========================================
# Default referral code to use when users sign up without a referral code
# This should be a valid referral code that exists in your database
# Leave empty if you don't want to assign a default referral code
DEFAULT_REFERRAL_CODE=

# ==========================================
# SESSION & SECURITY
# ==========================================
# Session timeout in milliseconds (default: 24 hours)
SESSION_TIMEOUT=86400000

# Maximum failed login attempts before account lock
MAX_LOGIN_ATTEMPTS=5

# Account lock duration in milliseconds (default: 30 minutes)
ACCOUNT_LOCK_DURATION=1800000

# Password reset token expiry (default: 1 hour)
PASSWORD_RESET_EXPIRY=3600000

# ==========================================
# RATE LIMITING
# ==========================================
# Rate limit window in milliseconds
RATE_LIMIT_WINDOW=900000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=5000

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
# Maximum file size for uploads in bytes
MAX_FILE_SIZE=52428800
MAX_VIDEO_SIZE=524288000

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Allowed origins (comma-separated for multiple origins)
CORS_ORIGINS=https://thefxnavigators.com,https://www.thefxnavigators.com,https://admin.thefxnavigators.com

# ==========================================
# WEBSOCKET CONFIGURATION
# ==========================================
# WebSocket is configured to use the same server
# Ensure FRONTEND_URL is correctly set above for CORS

# ==========================================
# LOGGING & MONITORING
# ==========================================
# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# ==========================================
# CRON JOBS & SCHEDULED TASKS
# ==========================================
# Enable scheduled notification processing
ENABLE_SCHEDULED_NOTIFICATIONS=true

# Notification processing interval (in minutes)
NOTIFICATION_PROCESSING_INTERVAL=5

# ==========================================
# MAINTENANCE MODE
# ==========================================
# Set to true to enable maintenance mode
MAINTENANCE_MODE=false

# Maintenance mode message
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance. Please check back soon.

# ==========================================
# BACKUP & RECOVERY
# ==========================================
# Backup configuration (if using automated backups)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ==========================================
# ANALYTICS & TRACKING
# ==========================================
# Google Analytics or other tracking IDs
ANALYTICS_ID=

# ==========================================
# THIRD-PARTY INTEGRATIONS
# ==========================================
# Add any additional third-party service credentials here
# Example: SMS service, push notification service, etc.

# Twilio (for SMS notifications - optional)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Firebase (for push notifications - optional)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ==========================================
# MT5 (MetaTrader 5) INTEGRATION
# ==========================================
# MT5 REST API configuration for trading integration
# Requires MT5 terminal with REST API enabled
# MT5_API_URL=http://localhost:8080
# MT5_LOGIN=your-mt5-login-number
# MT5_PASSWORD=your-mt5-password
# MT5_SERVER=your-mt5-server-name

# ==========================================
# REDIS CONFIGURATION (Optional)
# ==========================================
# If using Redis for caching or session storage
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ==========================================
# SSL/TLS CONFIGURATION
# ==========================================
# If serving over HTTPS directly from Node.js (usually handled by reverse proxy)
# SSL_KEY_PATH=/path/to/ssl/key.pem
# SSL_CERT_PATH=/path/to/ssl/cert.pem

# ==========================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ==========================================
# 1. Replace all placeholder values with actual credentials
# 2. NEVER commit this file to version control (add to .gitignore)
# 3. Use environment-specific .env files (.env.production, .env.staging)
# 4. Consider using secrets management (AWS Secrets Manager, HashiCorp Vault)
# 5. Ensure JWT_SECRET is a strong, unique random string
# 6. Use production URLs for all payment gateway callbacks
# 7. Enable HTTPS/SSL for all production endpoints
# 8. Configure proper MongoDB authentication and connection pooling
# 9. Set up monitoring and alerting for production errors
# 10. Regular backup of environment variables and database
# 11. Use Stripe LIVE keys (not test keys) in production
# 12. Verify all webhook URLs are accessible from payment gateways
# 13. Test email delivery with actual SMTP credentials
# 14. Configure proper rate limiting for production traffic
# 15. Set up log aggregation and monitoring (ELK, Datadog, etc.)

