{
  "name": "trading-education-platform",
  "version": "1.0.0",
  "description": "E-commerce + LMS platform for trading education",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install",
    "backup": "bash ./scripts/backup-all.sh",
    "restore": "bash ./scripts/restore-all.sh",
    "seed:monthly-fee-test-users": "node ./scripts/seed-monthly-fee-test-users.js",
    "seed:courses": "node ./scripts/seed-courses.js",
    "seed:student-dashboard": "node ./scripts/seed-student-dashboard.js",
    "seed:referral-tree": "node ./scripts/seed-referral-tree.js"
  },
  "keywords": [
    "trading",
    "education",
    "lms",
    "ecommerce",
    "nodejs",
    "mongodb"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "dotenv": "^16.3.1",
    "expo-server-sdk": "^3.15.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "speakeasy": "^2.0.0",
    "stripe": "^14.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
